# Server URL and published port
BIND_ADDRESS=
PORT=3000
QUEUE_SERVER_URL=
QUEUE_HOST_ADDRESS=
QUEUE_UID=
QUEUE_GID=

# All company login settings are supplied here or injected as environment variables.
# Default mode fails closed until the corporate settings below are provided.
AUTH_MODE=oidc
OIDC_ISSUER_URL=
# Optional full discovery URL; OIDC_ISSUER_URL remains required for validation.
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TOKEN_AUTH_METHOD=client_secret_basic
OIDC_SCOPES=openid profile email
# Empty = <QUEUE_SERVER_URL>/auth/callback
OIDC_REDIRECT_URI=
OIDC_PROMPT=
OIDC_AUTO_LOGIN=true
# Optional company-specific claims (standard profile/email scopes do not define PC data).
OIDC_DEVICE_ID_CLAIM=
OIDC_DEVICE_NAME_CLAIM=
SESSION_TTL_SECONDS=28800
DEVICE_KEY_TTL_DAYS=90
# Only for a localhost mock OIDC provider; never relaxes company HTTPS requirements.
OIDC_ALLOW_HTTP_LOCALHOST=false
# Optional company HTTPS mirror of the installer. Empty = public GitHub latest release.
CLIENT_WINDOWS_DOWNLOAD_URL=
