# Server start files detect the host IP and enable LAN binding. Raw Compose defaults to loopback.
BIND_ADDRESS=
PORT=3000
# Optional company HTTPS/reverse proxy URL. Empty = derive host address and published port.
QUEUE_SERVER_URL=
# Optional: override the IP detected by the server start file (VPN/multiple NICs).
QUEUE_HOST_ADDRESS=
# Linux only: set to the operator's `id -u` / `id -g` for Docker-based setup.
QUEUE_UID=
QUEUE_GID=
