# Server port is loopback-only by default. Use a company HTTPS reverse proxy for remote PCs.
BIND_ADDRESS=127.0.0.1
PORT=3000
# Set before FIRST setup so user bundles contain the correct server URL.
QUEUE_SERVER_URL=http://localhost:3000
# Linux only: set to the operator's `id -u` / `id -g` for Docker-based setup.
QUEUE_UID=0
QUEUE_GID=0
